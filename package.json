{
  "name": "ohmly-html-template",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "build": "sass HTML/scss/style.scss HTML/assets/css/style.css --no-source-map",
    "build:min": "sass HTML/scss/style.scss HTML/assets/css/style.min.css --style=compressed --no-source-map",
    "watch": "sass --watch HTML/scss/style.scss HTML/assets/css/style.css",
    "zip": "bash tools/package.sh"
  },
  "devDependencies": {
    "sass": "^1.80.0"
  },
  "description": "Ohmly - Electronics eCommerce HTML Template"
}
